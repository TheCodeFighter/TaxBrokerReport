{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker: build unit tests for debugging",
            "type": "process",
            "command": "${workspaceFolder}/scripts/debug_tests.sh",
            "args": ["build", "unit"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^/workspace/(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Docker: build integration tests for debugging",
            "type": "process",
            "command": "${workspaceFolder}/scripts/debug_tests.sh",
            "args": ["build", "integration"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^/workspace/(.+):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}
