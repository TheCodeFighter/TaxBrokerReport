# Words for the Trade Republic parser fuzzer: the header, the values the parser knows, and the
# characters that break CSV records. Synthetic only.
# The header column names, each quoted as in the export. libFuzzer drops an entry longer
# than 64 bytes, so the whole header is not one entry (the seeds hold it).
column_datetime="\x22datetime\x22"
column_date="\x22date\x22"
column_account_type="\x22account_type\x22"
column_category="\x22category\x22"
column_type="\x22type\x22"
column_asset_class="\x22asset_class\x22"
column_name="\x22name\x22"
column_symbol="\x22symbol\x22"
column_shares="\x22shares\x22"
column_price="\x22price\x22"
column_amount="\x22amount\x22"
column_fee="\x22fee\x22"
column_tax="\x22tax\x22"
column_currency="\x22currency\x22"
column_original_amount="\x22original_amount\x22"
column_original_currency="\x22original_currency\x22"
column_fx_rate="\x22fx_rate\x22"
column_description="\x22description\x22"
column_transaction_id="\x22transaction_id\x22"
column_counterparty_name="\x22counterparty_name\x22"
column_counterparty_iban="\x22counterparty_iban\x22"
column_payment_reference="\x22payment_reference\x22"
column_mcc_code="\x22mcc_code\x22"
